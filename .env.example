# Copy to .env and fill in. Real environment variables override this file.

# Where the agents save their data (the dashboard only READS these)
EVPROTO_LOGS_DIR=/path/to/whatsappai/ev-proto/logs
VOICE_RUNS_DIR=/path/to/voice-agent-llm-test/runs
# the real voice agent (LiveKit): its data/ folder with calls/ and speech_evals/
VOICE_AGENT_DATA_DIR=/path/to/ev-voice-agent/data
# new voice calls show up within this many seconds (the call list is reused in between)
VOICE_CACHE_SECONDS=15
# what the voice agent costs, in AED (0 = not set: the dashboard says so instead of showing a cost)
VOICE_GPU_COST_AED_MONTH=0
VOICE_OTHER_COST_AED_MONTH=0
VOICE_LINE_COST_AED_MIN=0
# the voice agent's calling limits (keep equal to MAX_CALLS_PER_DAY / MAX_CALLS_PER_WEEK in its .env)
VOICE_MAX_CALLS_PER_DAY=1
VOICE_MAX_CALLS_PER_WEEK=2
# report call records and recordings older than this many days (nothing is ever deleted)
VOICE_RETENTION_DAYS=365
# alerts (shown on the dashboard)
VOICE_ALERT_ERROR_RATE=0.10
VOICE_ALERT_WAIT_SECONDS=1.5
VOICE_ALERT_QUIET_HOURS=6
WA_ALERT_ERROR_RATE=0.10
WA_ALERT_UNANSWERED_RATE=0.25
WA_ALERT_WAIT_SECONDS=10
WA_ALERT_QUIET_HOURS=24
WA_ALERT_FAILED_LOGINS=10

# Required: signs the login cookie. Create one with:  python manage_users.py secret
DASHBOARD_SECRET_KEY=

# 127.0.0.1 = only this machine (use an SSH tunnel or a reverse proxy to reach it).
# Use the server's LAN address only behind HTTPS and only inside the company network.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8585

# Set to 1 when the dashboard is served over HTTPS (cookie is then sent over HTTPS only)
DASHBOARD_COOKIE_SECURE=0
# Set to 1 only when a reverse proxy you control sits in front and sets X-Forwarded-For
DASHBOARD_TRUST_PROXY=0

DASHBOARD_USERS_FILE=users.json
DASHBOARD_ACCESS_LOG=logs/dashboard_access.jsonl
DASHBOARD_SESSION_HOURS=8

# Charts use UAE time. Voice test logs are written in the server's local time without a zone.
DASHBOARD_UTC_OFFSET_HOURS=4
VOICE_LOG_UTC_OFFSET_HOURS=4
